rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ["owner", "editor"];
    }

    // Product images and content assets are public to read; only admins upload.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
