rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["owner", "editor"];
    }

    // Public catalog: anyone can read published items, only admins can write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Leads: anyone can create (newsletter/contact form), only admins can read/manage.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders: never written directly by clients — only Cloud Functions
    // (via the Admin SDK, which bypasses these rules) create/update orders.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal ops data: admin-only in both directions.
    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    match /socialPosts/{postId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // managed via Admin SDK / custom claims only
    }
  }
}
