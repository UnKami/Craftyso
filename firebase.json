{
  "apphosting": {
    "backendId": "craftyso-staging",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "antigravity-hero-videos",
      "contracts",
      "secret",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "source": "."
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
